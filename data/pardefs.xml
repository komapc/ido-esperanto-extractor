<pardefs>
    <pardef n="o__n">
      <e>
        <p>
          <l>o</l>
          <r><s n="n"/><s n="sg"/><s n="nom"/></r>
        </p>
      </e>
      <e>
        <p>
          <l>i</l>
          <r><s n="n"/><s n="pl"/><s n="nom"/></r>
        </p>
      </e>
      <!-- Relational adjective from nouns: ekonomi+ala → ekonomiala (relating to economy) -->
      <e><p><l>ala</l><r><s n="n"/><s n="der_ala"/><s n="adj"/><s n="sg"/><s n="nom"/></r></p></e>
      <!-- Adjectival derivation from nouns: suces+oza → sucesoza (full of success).
           Include <sg><nom> so remaining tags feed Epo autogen correctly. -->
      <e><p><l>oza</l><r><s n="n"/><s n="der_oz"/><s n="adj"/><s n="sg"/><s n="nom"/></r></p></e>
      <!-- Verb derivation from nouns: nom+izar → nomizar (to name); Epo stem+i.
           Full conjugation: izar/izas/izis/izos/izus/izez -->
      <e><p><l>izar</l><r><s n="n"/><s n="der_izar"/><s n="vblex"/><s n="inf"/></r></p></e>
      <e><p><l>izas</l><r><s n="n"/><s n="der_izar"/><s n="vblex"/><s n="pri"/></r></p></e>
      <e><p><l>izis</l><r><s n="n"/><s n="der_izar"/><s n="vblex"/><s n="pii"/></r></p></e>
      <e><p><l>izos</l><r><s n="n"/><s n="der_izar"/><s n="vblex"/><s n="fti"/></r></p></e>
      <e><p><l>izus</l><r><s n="n"/><s n="der_izar"/><s n="vblex"/><s n="cni"/></r></p></e>
      <e><p><l>izez</l><r><s n="n"/><s n="der_izar"/><s n="vblex"/><s n="imp"/></r></p></e>
      <!-- Feminine derivation: vir+ino → virino (woman), kat+ino → katino (female cat).
           Tags mirror Esperanto: viro<n><f><sg><nom> → virino via autogen. -->
      <e><p><l>ino</l><r><s n="n"/><s n="f"/><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l>ini</l><r><s n="n"/><s n="f"/><s n="pl"/><s n="nom"/></r></p></e>
      <!-- Concretization-from-noun: Esperant+ajo → Esperantajo (an Esperanto-thing).
           EO equivalent uses -aĵo (handled in transfer rules / EO morphology). -->
      <e><p><l>ajo</l><r><s n="n"/><s n="der_aj"/><s n="n"/><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l>aji</l><r><s n="n"/><s n="der_aj"/><s n="n"/><s n="pl"/><s n="nom"/></r></p></e>
      <!-- Collective from nouns: mont+aro → montaro (mountain range), hom+aro → homaro
           (humanity), person+aro → personaro (personnel). EO collective is also -aro,
           generated compositionally by apertium-epo, so the right side carries the EO
           collective lemma (montaro<n>) and <sg/pl><nom> passes through. -->
      <e><p><l>aro</l><r><s n="n"/><s n="der_aro"/><s n="n"/><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l>ari</l><r><s n="n"/><s n="der_aro"/><s n="n"/><s n="pl"/><s n="nom"/></r></p></e>
    </pardef>
    <pardef n="a__adj">
      <e>
        <p>
          <l>a</l>
          <r><s n="adj"/></r>
        </p>
      </e>
      <!-- Quality nouns: bon+eso → boneso (goodness); maps to Epo bon+eco -->
      <e><p><l>eso</l><r><s n="adj"/><s n="der_qual"/><s n="n"/><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l>esi</l><r><s n="adj"/><s n="der_qual"/><s n="n"/><s n="pl"/><s n="nom"/></r></p></e>
      <!-- Concretization-from-adj: bel+ajo → belajo (a beautiful thing). -->
      <e><p><l>ajo</l><r><s n="adj"/><s n="der_aj"/><s n="n"/><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l>aji</l><r><s n="adj"/><s n="der_aj"/><s n="n"/><s n="pl"/><s n="nom"/></r></p></e>
    </pardef>
    <pardef n="ebl__adj">
      <e>
        <p>
          <l>ebla</l>
          <r><s n="adj"/></r>
        </p>
      </e>
    </pardef>
    <pardef n="e__adv">
      <e>
        <p>
          <l>e</l>
          <r><s n="adv"/></r>
        </p>
      </e>
    </pardef>
    <pardef n="ar__vblex">
      <e>
        <p>
          <l>ar</l>
          <r><s n="vblex"/><s n="inf"/></r>
        </p>
      </e>
      <e>
        <p>
          <l>as</l>
          <r><s n="vblex"/><s n="pri"/></r>
        </p>
      </e>
      <e>
        <p>
          <l>is</l>
          <r><s n="vblex"/><s n="pii"/></r>
        </p>
      </e>
      <e>
        <p>
          <l>os</l>
          <r><s n="vblex"/><s n="fti"/></r>
        </p>
      </e>
      <e>
        <p>
          <l>us</l>
          <r><s n="vblex"/><s n="cni"/></r>
        </p>
      </e>
      <e>
        <p>
          <l>ez</l>
          <r><s n="vblex"/><s n="imp"/></r>
        </p>
      </e>
      <!-- Present-agent nouns: kre+anto → kreanto (one who creates) -->
      <e><p><l>anto</l><r><s n="vblex"/><s n="der_pres"/><s n="n"/><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l>anti</l><r><s n="vblex"/><s n="der_pres"/><s n="n"/><s n="pl"/><s n="nom"/></r></p></e>
      <!-- Action nouns: kre+ado → kreado (the act of creating) -->
      <e><p><l>ado</l><r><s n="vblex"/><s n="der_act"/><s n="n"/><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l>adi</l><r><s n="vblex"/><s n="der_act"/><s n="n"/><s n="pl"/><s n="nom"/></r></p></e>
      <!-- Past-agent nouns: kre+into → kreinto (one who created) -->
      <e><p><l>into</l><r><s n="vblex"/><s n="der_past"/><s n="n"/><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l>inti</l><r><s n="vblex"/><s n="der_past"/><s n="n"/><s n="pl"/><s n="nom"/></r></p></e>
      <!-- Future-agent nouns: kre+onto → kreonto (one who will create) -->
      <e><p><l>onto</l><r><s n="vblex"/><s n="der_onto"/><s n="n"/><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l>onti</l><r><s n="vblex"/><s n="der_onto"/><s n="n"/><s n="pl"/><s n="nom"/></r></p></e>
      <!-- Past-active participle (adj): kre+inta → kreinta; needs <sg> (no <nom>) for pp3 Epo generation -->
      <e><p><l>inta</l><r><s n="vblex"/><s n="der_ppa"/><s n="adj"/><s n="sg"/></r></p></e>
      <!-- Past-passive participle (adj): kre+ita → kreita (created) -->
      <e><p><l>ita</l><r><s n="vblex"/><s n="der_ppas"/><s n="adj"/><s n="sg"/><s n="nom"/></r></p></e>
      <!-- Present-passive participle (adj): kre+ata → kreata (being created) -->
      <e><p><l>ata</l><r><s n="vblex"/><s n="der_pprs"/><s n="adj"/><s n="sg"/><s n="nom"/></r></p></e>
      <!-- Future-passive participle (adj): kre+ota → kreota (about to be created) -->
      <e><p><l>ota</l><r><s n="vblex"/><s n="der_pfut"/><s n="adj"/><s n="sg"/><s n="nom"/></r></p></e>
      <!-- Present-active participle (adj): kre+anta → kreanta (creating) -->
      <e><p><l>anta</l><r><s n="vblex"/><s n="der_ppra"/><s n="adj"/><s n="sg"/><s n="nom"/></r></p></e>
      <!-- Future-active participle (adj): kre+onta → kreonta (about to create); needs
           <sg> (no <nom>), since apertium-epo's pp2 tag rejects <nom>, same as pp3 above. -->
      <e><p><l>onta</l><r><s n="vblex"/><s n="der_onta"/><s n="adj"/><s n="sg"/></r></p></e>
      <!-- Participial adverbs (gerunds): kre+ante → kreante (while creating),
           kre+inte → kreinte (having created). Adverbs are invariant in both
           Ido and Epo, so no further tags are needed. Epo generates these via
           its own <ger>/<gerpast> tags, see build_bidix. -->
      <e><p><l>ante</l><r><s n="vblex"/><s n="der_ante"/><s n="adv"/></r></p></e>
      <e><p><l>inte</l><r><s n="vblex"/><s n="der_inte"/><s n="adv"/></r></p></e>
      <!-- Remaining participial adverbs (future-active, and all 3 passive) are
           NOT generatable by apertium-epo for any verb stem (confirmed:
           #kuronte/#manĝonte, #kurate/#kurite/#kurote all fail lt-proc -g),
           so monodix analysis only, no bidix pair (see build_bidix). -->
      <e><p><l>onte</l><r><s n="vblex"/><s n="der_onte"/><s n="adv"/></r></p></e>
      <e><p><l>ate</l><r><s n="vblex"/><s n="der_ate"/><s n="adv"/></r></p></e>
      <e><p><l>ite</l><r><s n="vblex"/><s n="der_ite"/><s n="adv"/></r></p></e>
      <e><p><l>ote</l><r><s n="vblex"/><s n="der_ote"/><s n="adv"/></r></p></e>
      <!-- Passive verb derivation: kre+esar → kreesar (to be created); Epo: krei+ĝi = kreiĝi -->
      <e><p><l>esar</l><r><s n="vblex"/><s n="der_esar"/><s n="vblex"/><s n="inf"/></r></p></e>
      <e><p><l>esas</l><r><s n="vblex"/><s n="der_esar"/><s n="vblex"/><s n="pri"/></r></p></e>
      <e><p><l>esis</l><r><s n="vblex"/><s n="der_esar"/><s n="vblex"/><s n="pii"/></r></p></e>
      <e><p><l>esos</l><r><s n="vblex"/><s n="der_esar"/><s n="vblex"/><s n="fti"/></r></p></e>
      <e><p><l>esus</l><r><s n="vblex"/><s n="der_esar"/><s n="vblex"/><s n="cni"/></r></p></e>
      <e><p><l>esez</l><r><s n="vblex"/><s n="der_esar"/><s n="vblex"/><s n="imp"/></r></p></e>
    </pardef>
    <pardef n="num">
      <e>
        <p>
          <l/>
          <r><s n="num"/></r>
        </p>
      </e>
    </pardef>
    <pardef n="num_regex">
      <e>
        <re>[0-9]+([.,][0-9]+)*</re>
        <p>
          <l/>
          <r><s n="num"/><s n="ciph"/><s n="sp"/><s n="nom"/></r>
        </p>
      </e>
    </pardef>
    <!-- Digit-form ordinals: 1ma / 16ma / 16-ma → "first" / "sixteenth"
         Ido attaches -ma (sometimes -esma) to a numeral to form an ordinal.
         When the base is digits, the surface form is just digit(s) + optional
         hyphen + 'ma'. -->
    <pardef n="num_ord_regex">
      <e>
        <re>[0-9]+\-?ma</re>
        <p>
          <l/>
          <r><s n="num"/><s n="ord"/></r>
        </p>
      </e>
    </pardef>
